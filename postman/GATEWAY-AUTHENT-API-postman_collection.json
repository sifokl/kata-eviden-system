    {
      "name": "07 - /api/me - USER JWT - Expected 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_access_token}}"
          }
        ],
        "url": {
          "raw": "{{gateway_base_url}}/api/me",
          "host": ["{{gateway_base_url}}"],
          "path": ["api", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('USER /api/me returns HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Principal username is user', function () {",
              "    pm.expect(json.preferredUsername).to.eql('user');",
              "});",
              "",
              "pm.test('USER role is present', function () {",
              "    pm.expect(json.roles).to.include('ROLE_USER');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
