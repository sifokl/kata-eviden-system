{
  "info": {
    "_postman_id": "2b9c9a94-7a2c-4fc9-91ec-eviden-gateway",
    "name": "Eviden Auth Gateway - Full Scenarios",
    "description": "Postman collection for testing the Eviden Authentication Gateway kata: token generation, public routes, protected routes, 401 and 403 scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "keycloak_base_url",
      "value": "http://localhost:8180"
    },
    {
      "key": "gateway_base_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "realm",
      "value": "eviden-kata"
    },
    {
      "key": "client_id",
      "value": "gateway-client"
    },
    {
      "key": "client_secret",
      "value": "gateway-secret"
    },
    {
      "key": "user_access_token",
      "value": ""
    },
    {
      "key": "admin_access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Get USER Access Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "password", "type": "text" },
            { "key": "client_id", "value": "{{client_id}}", "type": "text" },
            { "key": "client_secret", "value": "{{client_secret}}", "type": "text" },
            { "key": "username", "value": "user", "type": "text" },
            { "key": "password", "value": "user", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{keycloak_base_url}}/realms/{{realm}}/protocol/openid-connect/token",
          "host": ["{{keycloak_base_url}}"],
          "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('USER token request returns HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('USER access_token is present', function () {",
              "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.test('Token type is Bearer', function () {",
              "    pm.expect(json.token_type).to.eql('Bearer');",
              "});",
              "",
              "pm.collectionVariables.set('user_access_token', json.access_token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
