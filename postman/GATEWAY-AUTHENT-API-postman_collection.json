      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('No JWT returns HTTP 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Error payload contains Unauthorized', function () {",
              "    pm.expect(json.status).to.eql(401);",
              "    pm.expect(json.error).to.eql('Unauthorized');",
              "});",
              "",
              "pm.test('Path is /api/me', function () {",
              "    pm.expect(json.path).to.eql('/api/me');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
